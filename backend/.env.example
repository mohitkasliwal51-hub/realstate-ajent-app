# StayFile Backend Environment Variables - Example
# Copy this to .env and fill in your values

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stayfile
DB_USERNAME=postgres
DB_PASSWORD=postgres

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cashfree Payment Links (sandbox)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_PAYMENT_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_PAYMENT_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_NOTIFY_URL=
CASHFREE_PAYMENT_RETURN_URL=

# Spring Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Logging Configuration
LOGGING_LEVEL_COM_BHARTIYASAAS_STAYFILE=DEBUG
LOGGING_LEVEL_ROOT=INFO

# JPA Configuration
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# Security Configuration
JWT_SECRET=fMoarndXgVPB6VwaPCF2NtUyOxjIsdn9QjruuUlHE9w=
JWT_EXPIRATION=86400000
