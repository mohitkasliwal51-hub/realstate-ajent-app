# StayFile Production Environment Variables
# Copy this file to .env.prod or .env and populate with secure, high-entropy secrets

# Database Configuration
POSTGRES_DB=stayfile
POSTGRES_USER=stayfile_prod_user
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# Security Secrets (Generate using openssl rand -base64 48 or 256-bit key)
JWT_SECRET=generate_a_random_base64_jwt_secret_at_least_256_bits
PII_SECRET_KEY=generate_a_random_aes_gcm_256_bit_secret_key

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Docker Compose
COMPOSE_PROJECT_NAME=stayfile-prod
