# Docker Compose Environment Variables - Example
# Copy this file to .env and modify as needed

# Database Configuration (for Docker Compose)
DB_HOST=database
DB_PORT=5432
DB_NAME=stayfile
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PII_SECRET_KEY=your-32-byte-base64-pii-secret-key-here

# Port Configuration
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_PORT_HOST=5433

# Docker Configuration
COMPOSE_PROJECT_NAME=stayfile-app

# Note: 
# - Individual service environment variables are in backend/.env and frontend/.env
# - This file is used by docker-compose for container orchestration
# - For local development without Docker, configure backend/.env and frontend/.env instead
